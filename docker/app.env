# Production defaults baked into the image as /app/.env (see docs/docker.md).
#
# The image does not copy the repository's `.env`: Dokploy writes the service environment to
# `.env` next to compose.yaml, i.e. over the repository's file, before it builds. Copying it
# would bake the instance's secrets into an image layer and lose these defaults. Real
# environment variables always win over the values here.
APP_ENV=prod
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
DATABASE_URL="sqlite:///%kernel.project_dir%/data/queue_%kernel.environment%.db"
PRINTER_DSN=dummy://
DATA_DIR="/data/receipts/"
RECEIPT_RETENTION_DAYS=30
HEARTBEAT_URL=
LOG_LEVEL=notice
