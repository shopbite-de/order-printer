{
  "groups": {
    "group:admins": ["lirim@veliu.net"]
  },

  "tagOwners": {
    "tag:server": ["group:admins"],
    "tag:printer": ["group:admins"]
  },

  "grants": [
    {
      "src": ["tag:server"],
      "dst": ["tag:printer"],
      "ip": ["tcp:9100"]
    },
    {
      "src": ["group:admins"],
      "dst": ["tag:printer"],
      "ip": ["tcp:22", "tcp:9100"]
    },
    {
      "src": ["group:admins"],
      "dst": ["tag:server"],
      "ip": ["tcp:22"]
    }
  ],

  "ssh": [
    {
      "action": "check",
      "checkPeriod": "12h",
      "src": ["group:admins"],
      "dst": ["tag:printer", "tag:server"],
      "users": ["autogroup:nonroot", "root"]
    }
  ],

  "tests": [
    {
      "src": "tag:server",
      "accept": ["tag:printer:9100"],
      "deny": ["tag:printer:22", "tag:printer:80"]
    },
    {
      "src": "tag:printer",
      "deny": ["tag:server:22", "tag:server:9100", "tag:printer:9100", "tag:printer:22"]
    },
    {
      "src": "group:admins",
      "accept": ["tag:printer:22", "tag:printer:9100", "tag:server:22"]
    }
  ],

  "sshTests": [
    {
      "src": "tag:server",
      "dst": ["tag:printer"],
      "deny": ["pi", "root"]
    }
  ]
}
