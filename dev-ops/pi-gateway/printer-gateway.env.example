# Copy this file as printer-gateway.env onto the boot partition of a freshly flashed Pi
# gateway image (the FAT partition that Windows and macOS show as "bootfs"). On the first boot
# the Pi becomes printer-<CUSTOMER>, joins the tailnet and deletes this file.

# Shop slug: lowercase letters, digits, dashes. Hostname becomes printer-<CUSTOMER>.
CUSTOMER=masala-mio

# Tailscale auth key with tag:printer (reusable, pre-authorized), from the password manager.
TS_AUTHKEY=tskey-auth-...

# Optional WLAN, only when there is no Ethernet.
#WIFI_SSID=
#WIFI_PASSWORD=
